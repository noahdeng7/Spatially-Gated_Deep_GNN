    given-names: Noah
    email: noahjamesdengler@gmail.com
    # TODO: add affiliation and ORCID
    # affiliation: ""
    # orcid: "https://orcid.org/0000-0000-0000-0000"

# TODO: set once the repository is public / archived
repository-code: "https://github.com/noahdeng7/Spatially-Gated_Deep_GNN"
# TODO: mint a DOI (e.g. archive the release on Zenodo) and add it here
# doi: "10.5281/zenodo.XXXXXXX"

keywords:
  - internal migration
  - gravity model
  - graph neural network
  - spatial econometrics
  - Mexico
  - climate mobility

